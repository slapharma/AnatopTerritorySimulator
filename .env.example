# Copy this file to .env and paste your OpenRouter API key after the = sign.
# Get a key: https://openrouter.ai/  ->  Keys  ->  Create Key
# The default model is a free NVIDIA model, so token cost is zero. Free models are
# rate-limited (about 20 requests a minute, and a daily cap that rises once the
# account holds $10 of credit). One agent turn makes several requests.
OPENROUTER_API_KEY=

# Recommended: Tavily Search API key. Free (1000 req/month, no card required),
# and — unlike DuckDuckGo below — a real API that works from cloud/serverless IPs.
# https://tavily.com/  ->  sign up  ->  copy the key (starts tvly-)
# TAVILY_API_KEY=

# Alternative: Brave Search API key (free tier requires a $5 pre-payment).
# https://brave.com/search/api/
# BRAVE_API_KEY=

# Without either key above, the app scrapes DuckDuckGo's HTML search page.
# This works from a normal residential/office IP but returns HTTP 403 for every
# query from most cloud/datacenter IPs (Vercel included) — fine for quick local
# testing, not for a real deployment.

# Optional overrides (defaults shown)
# PORT=3000
# Where npm packages were installed (see README: Google Drive cannot hold node_modules)
# LWG_MODULES=C:\Users\<you>\AppData\Local\launch-working-group\node_modules

# Postgres connection (Supabase). Required for saved sessions to persist / be
# shared across browsers. Use the pooler URL (port 6543), not the direct host.
#
# TLS: Supabase's pooler chains to their own root, which the system CA store
# does not know, so the app pins certs/supabase-prod-ca-2021.pem and verifies
# against it. Nothing to set for a Supabase database.
#   DATABASE_CA=/path/to/ca.pem   point at a different CA (non-Supabase Postgres)
#   DATABASE_SSL_INSECURE=1       connect WITHOUT verifying the certificate.
#                                 Last resort only, e.g. if Supabase rotates the
#                                 root before this file is updated. It logs a
#                                 warning on every boot; replace the pinned
#                                 certificate instead wherever possible.
DATABASE_URL=

# Sign-in. Users live in the `users` table; AUTH_USERS/AUTH_PASSWORD are only a
# one-time seed for it, applied when the table is still empty. AUTH_USERS is a
# comma-separated list of emails (the first becomes the admin); AUTH_PASSWORD is
# shared by all of them. Leave both blank to disable auth (local dev only —
# never applies on Vercel).
AUTH_USERS=
AUTH_PASSWORD=

# Signing key for session cookies, so people stay signed in. REQUIRED in
# production: without it, form sign-in is switched off on Vercel rather than run
# on a per-instance key that would sign everyone out at random. Basic auth keeps
# working either way, so a missing key locks nobody out permanently.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Email (sent via Resend: https://resend.com — free tier 3,000/month, no SMTP,
# no card required). Get a key: Resend dashboard -> API Keys -> Create API Key.
# Leave blank to disable: report emails show "Email not configured" and 503;
# meeting-minutes emails are skipped with a log line.
RESEND_API_KEY=

# Report emails (Interim/Final, on demand): sender must be on a domain verified
# in Resend, or every send fails.
MAIL_FROM=

# Meeting-minutes emails (sent automatically after each round): the default
# below is Resend's shared sandbox sender and needs no domain verification;
# swap in your own verified domain address in production.
# RESEND_FROM=onboarding@resend.dev
# Fallback recipient when auth is disabled (no logged-in user email to send to).
# MODERATOR_EMAIL=
# Public URL of this deployment, used to build the links inside meeting-minutes
# emails (View online / transcript / approve). Defaults to http://localhost:PORT.
# BASE_URL=
