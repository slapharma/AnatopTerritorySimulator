# Copy this file to .env and paste your OpenRouter API key after the = sign.
# Get a key: https://openrouter.ai/  ->  Keys  ->  Create Key
# The default model is a free NVIDIA model, so token cost is zero. Free models are
# rate-limited (about 20 requests a minute, and a daily cap that rises once the
# account holds $10 of credit). One agent turn makes several requests.
OPENROUTER_API_KEY=

# Recommended: Tavily Search API key. Free (1000 req/month, no card required),
# and — unlike DuckDuckGo below — a real API that works from cloud/serverless IPs.
# https://tavily.com/  ->  sign up  ->  copy the key (starts tvly-)
# TAVILY_API_KEY=

# Alternative: Brave Search API key (free tier requires a $5 pre-payment).
# https://brave.com/search/api/
# BRAVE_API_KEY=

# Without either key above, the app scrapes DuckDuckGo's HTML search page.
# This works from a normal residential/office IP but returns HTTP 403 for every
# query from most cloud/datacenter IPs (Vercel included) — fine for quick local
# testing, not for a real deployment.

# Optional overrides (defaults shown)
# PORT=3000
# Where npm packages were installed (see README: Google Drive cannot hold node_modules)
# LWG_MODULES=C:\Users\<you>\AppData\Local\launch-working-group\node_modules

# Postgres connection (Supabase). Required for saved sessions to persist / be
# shared across browsers. Use the pooler URL (port 6543), not the direct host.
DATABASE_URL=

# Password-gate the whole app (HTTP Basic Auth). AUTH_USERS is a comma-separated
# list of allowed emails; AUTH_PASSWORD is shared by all of them. Leave both blank
# to disable auth (local dev).
AUTH_USERS=
AUTH_PASSWORD=

# Meeting minutes email (sent via Resend: https://resend.com — free tier, no card).
# Get a key: Resend dashboard -> API Keys -> Create API Key.
# RESEND_API_KEY=
# Sender address. The default below is Resend's shared sandbox sender and needs
# no domain verification; swap in your own verified domain address in production.
# RESEND_FROM=onboarding@resend.dev
# Fallback recipient when auth is disabled (no logged-in user email to send to).
# MODERATOR_EMAIL=
# Public URL of this deployment, used to build the links inside meeting-minutes
# emails (View online / transcript / approve). Defaults to http://localhost:PORT.
# BASE_URL=
